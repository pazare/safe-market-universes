.DS_Store
.env
.venv/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.pyc
*.pyo
*.log
*.tmp
build/
dist/
*.egg-info/
outputs/*.png

# Scratch / smoke / tuning / validation benchmark runs (not part of the published artifact)
outputs/benchmark/smu_smoke*/
outputs/benchmark/smu_progress_smoke/
outputs/benchmark/smu_live_api_probe_bounded/
outputs/benchmark/smu_ticker_check/
outputs/benchmark/smu_tuning*/
outputs/benchmark/smu_validation*/
outputs/benchmark/publication_gpt_5_4_seed*/

outputs/academic_data_status.json

# Old single-ticker analysis outputs (superseded by the benchmark)
outputs/*.json
!outputs/model_preflight.json
outputs/hypothetical_monitor/

# Locally regenerated exports (committed copies live elsewhere)
report/langgraph_workflow.mmd
report/figures/smu_headline_v1/
report/figures/smu_tuning*/
report/figures/smu_validation*/

# Human-audit packets stay local (blank reviewer templates), but the audit summary ships
outputs/human_audit/*
!outputs/human_audit/smu_headline_v1/
outputs/human_audit/smu_headline_v1/*
!outputs/human_audit/smu_headline_v1/human_audit_summary.json
