OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=60
SMU_STEP_TIMEOUT_SECONDS=300

# Optional external MCP tooling endpoint.
# This repo does not read the variable directly in application code,
# but you may use it in your local Codex/MCP setup if you are connecting
# to Tavily's remote MCP service.
TAVILY_REMOTE_MCP_URL=

# yfinance does not require a Yahoo Finance API key.
# Leave this repo key-free on the market-data side unless you later
# add a different financial API that explicitly requires credentials.

# Optional WRDS academic-data check. Do not commit real credentials.
# After creating a WRDS account through institutional access, set this
# locally and run: python scripts/check_academic_data.py
WRDS_USERNAME=

# Set to 1 to force fresh yfinance downloads instead of using .cache/market_data.
SMU_MARKET_DATA_CACHE_DISABLED=0
